# Example configuration for the translation service.
# Copy this file to .env for local testing.
# For GitHub Actions, configure these values under
# Repository Settings → Secrets and variables → Actions.
# See /scripts/translators/ for available provider implementations.

# Supported providers: gemini (more can be added).
TRANSLATOR_PROVIDER=gemini

# Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
